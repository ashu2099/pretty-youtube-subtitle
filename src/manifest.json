{
  "manifest_version": 3,
  "name": "YouTube Subtitle Styler",
  "version": "1.0.0",
  "description": "Customize YouTube subtitle font size, color, background opacity, stroke, and shadow.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-subtitle-styler@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "YouTube Subtitle Styler",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
